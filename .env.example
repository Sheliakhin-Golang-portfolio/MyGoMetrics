# HTTP server listen address (e.g., :9000 or 0.0.0.0:9000)
# This can be overridden by command-line flags
LISTEN_ADDR=:9000

# Interval between collector runs (e.g., 15s, 30s, 1m)
# Default: 15s
# This can be overridden by command-line flags
COLLECT_INTERVAL=15s

# Hostname label value for Prometheus metrics
# Default: os.Hostname() or "unknown"
# This can be overridden by command-line flags
HOST=

# Environment label value for Prometheus metrics (e.g., production, staging, development)
# Default: empty string
# This can be overridden by command-line flags
ENV=

# Comma-separated list of collector names to enable (e.g., cpu,memory,disk,runtime)
# Default: empty (all collectors enabled)
# Valid collector names: cpu, memory, disk, runtime
# This can be overridden by command-line flags
ENABLED_COLLECTORS=

# Logging level: debug, info, warn, error
# Default: info
# This can be overridden by command-line flags
LOG_LEVEL=info